---
import { LOCALES, localizedPath, DEFAULT_LOCALE } from '../lib/i18n';
import { SITE, NAV } from '../data/site';
import { TOOLS } from '../data/tools';
import { getUi, getTools } from '../lib/content';
import SeoHead from '../components/SeoHead.astro';
import globalCss from '../styles/global.css?inline';

interface Props {
  locale: string;
  route: string; // locale-agnostic, e.g. "/tools"
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { locale, route, title, description, jsonLd } = Astro.props;
const ui = getUi(locale);
const toolCopy = getTools(locale);
const getToolName = (slug: string) => toolCopy[slug]?.h1 ?? slug;
const current = LOCALES.find((l) => l.code === locale) ?? LOCALES[0];
const isRtl = current.code === 'ar';
const otherLocales = LOCALES.filter((l) => l.code !== locale);
const home = localizedPath(current, '/');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={current.code} dir={isRtl ? 'rtl' : 'ltr'}>
  <head>
    <SeoHead title={title} description={description} route={route} locale={locale} jsonLd={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#e11d48" />
    <slot name="head" />
    <style is:inline set:html={globalCss}></style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={home} aria-label={SITE.name}>
          <span class="brand-mark" aria-hidden="true">⬇</span>
          <span class="brand-name">{SITE.name}</span>
        </a>

        <nav class="nav" aria-label="Main">
          {NAV.map((item) =>
            item.key === 'tools' ? (
              <details class="nav-drop">
                <summary class="nav-link">{ui.nav.tools}</summary>
                <div class="nav-drop-menu">
                  <a href={localizedPath(current, '/tools')}>All tools</a>
                  {TOOLS.map((t) => (
                    <a href={localizedPath(current, `/tools/${t.slug}`)}>{getToolName(t.slug)}</a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={localizedPath(current, item.route)}
                class:list={['nav-link', { active: route === item.route }]}
              >
                {ui.nav[item.key] ?? item.key}
              </a>
            )
          )}
        </nav>

        {otherLocales.length > 0 && (
          <details class="lang">
            <summary class="lang-toggle">{current.label}</summary>
            <div class="lang-menu">
              {LOCALES.map((l) => (
                <a
                  key={l.code}
                  href={localizedPath(l, route)}
                  hreflang={l.code}
                  class:list={['lang-option', { selected: l.code === locale }]}
                >
                  {l.label}
                </a>
              ))}
            </div>
          </details>
        )}
      </div>
    </header>

    <main class="wrap main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-col footer-about">
          <div class="brand">
            <span class="brand-mark" aria-hidden="true">⬇</span>
            <span class="brand-name">{SITE.name}</span>
          </div>
          <p class="muted">{ui.footer.tagline}</p>
          <div class="badges">
            <span class="badge">{ui.common.safePrivate}</span>
            <span class="badge">{ui.common.noReg}</span>
          </div>
          <p class="fineprint">{SITE.name} {ui.common.independent}</p>
        </div>

        <div class="footer-col">
          <h4>{ui.common.quickLinks}</h4>
          <a href={localizedPath(current, '/como-usar')}>{ui.nav.howto}</a>
          <a href={localizedPath(current, '/acerca-de')}>{ui.nav.about}</a>
          <a href={localizedPath(current, '/contacto')}>{ui.nav.contact}</a>
          <a href={localizedPath(current, '/preguntas-frecuentes')}>{ui.nav.faq}</a>
        </div>

        <div class="footer-col">
          <h4>{ui.common.legal}</h4>
          <a href={localizedPath(current, '/terminos')}>Terms of Service</a>
          <a href={localizedPath(current, '/privacidad')}>Privacy Policy</a>
          <a href={localizedPath(current, '/dmca')}>DMCA</a>
          <a href={localizedPath(current, '/politica-de-cookies')}>Cookie Policy</a>
        </div>
      </div>

      <div class="wrap footer-tools-wrap">
        <h4>{ui.common.tools}</h4>
        <div class="footer-tools">
          <a href={localizedPath(current, '/')}>TikTok Video Downloader</a>
          {TOOLS.map((t) => (
            <a href={localizedPath(current, `/tools/${t.slug}`)}>{getToolName(t.slug)}</a>
          ))}
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p class="fineprint">© {year} {SITE.name}. {ui.common.rights}</p>
        <p class="fineprint">{ui.common.freeForever}</p>
        <p class="fineprint">{ui.common.madeWith} ♥ in the Dominican Republic</p>
      </div>
    </footer>
  </body>
</html>