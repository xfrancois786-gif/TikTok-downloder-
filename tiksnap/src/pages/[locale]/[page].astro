---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import { getUi, getPages } from '../../lib/content';
import { INFO_PAGES } from '../../data/tools';
import { localizedPath, localeParams, DEFAULT_LOCALE, localeFor } from '../../lib/i18n';

export function getStaticPaths() {
  const pages = INFO_PAGES.filter((p) => p.slug !== 'como-usar' && p.slug !== 'preguntas-frecuentes');
  return localeParams().flatMap((lp) =>
    pages.map((p) => ({ params: { ...lp, page: p.slug } }))
  );
}

const { page: slug } = Astro.params;
const locale = Astro.params.locale ?? DEFAULT_LOCALE;
const route = `/${slug}`;
const ui = getUi(locale);
const page = getPages(locale).find((p) => p.slug === slug);
const current = localeFor(locale)!;

if (!page) return Astro.redirect('/');

const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.nav.home, item: localizedPath(current, '/') },
    { '@type': 'ListItem', position: 2, name: page.h1, item: localizedPath(current, route) },
  ],
};
const faqLd = page.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: page.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
const jsonLd = [crumbLd, ...(faqLd ? [faqLd] : [])];
---

<BaseLayout
  locale={locale}
  route={route}
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
>
  <div class="crumbs"><a href={localizedPath(current, '/')}>{ui.nav.home}</a> / {page.h1}</div>
  <article class="post-body" style="max-width:760px">
    <h1 style="font-size:clamp(26px,4vw,38px);margin:0 0 12px">{page.h1}</h1>
    <p class="lead">{page.intro}</p>

    {page.steps && (
      <div class="grid" style="margin-top:24px">
        {page.steps.map((s, i) => (
          <div class="card">
            <h3>{i + 1}. {s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    )}

    {page.body && <p style="margin-top:20px">{page.body}</p>}

    {page.faqs && page.faqs.length > 0 && (
      <div style="margin-top:24px"><Faq items={page.faqs} /></div>
    )}
  </article>
</BaseLayout>