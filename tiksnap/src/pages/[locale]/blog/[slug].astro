---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getUi, getBlog } from '../../../lib/content';
import { localizedPath, localeParams, DEFAULT_LOCALE, localeFor } from '../../../lib/i18n';

export function getStaticPaths() {
  const slugs = getBlog(DEFAULT_LOCALE).map((p) => p.slug);
  return localeParams().flatMap((lp) => slugs.map((slug) => ({ params: { ...lp, slug } })));
}

const { slug } = Astro.params;
const locale = Astro.params.locale ?? DEFAULT_LOCALE;
const route = `/blog/${slug}`;
const ui = getUi(locale);
const post = getBlog(locale).find((p) => p.slug === slug)!;
const current = localeFor(locale)!;
const url = localizedPath(current, route);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  author: { '@type': 'Person', name: post.author },
  mainEntityOfPage: url,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.nav.home, item: localizedPath(current, '/') },
    { '@type': 'ListItem', position: 2, name: ui.nav.blog, item: localizedPath(current, '/blog') },
    { '@type': 'ListItem', position: 3, name: post.title, item: url },
  ],
};
---

<BaseLayout
  locale={locale}
  route={route}
  title={post.title}
  description={post.description}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <div class="crumbs">
    <a href={localizedPath(current, '/')}>{ui.nav.home}</a> /{' '}
    <a href={localizedPath(current, '/blog')}>{ui.nav.blog}</a> / {post.title}
  </div>
  <article class="post-body" style="max-width:760px">
    <span class="date muted">{post.date} · {post.author}</span>
    <h1 style="font-size:clamp(26px,4vw,38px);margin:8px 0 12px">{post.title}</h1>
    <p class="lead">{post.intro}</p>
    {post.sections.map((s) => (
      <>
        <h2>{s.h}</h2>
        <p>{s.p}</p>
      </>
    ))}
    <p style="margin-top:32px">
      <a class="go" href={localizedPath(current, '/')}>{ui.common.backHome} →</a>
    </p>
  </article>
</BaseLayout>