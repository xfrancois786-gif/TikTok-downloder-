---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolForm from '../../components/ToolForm.astro';
import Faq from '../../components/Faq.astro';
import { getUi, getHowto } from '../../lib/content';
import { localizedPath, localeParams, DEFAULT_LOCALE, localeFor } from '../../lib/i18n';

export function getStaticPaths() {
  return localeParams().map((p) => ({ params: p }));
}

const locale = Astro.params.locale ?? DEFAULT_LOCALE;
const route = '/como-usar';
const ui = getUi(locale);
const page = getHowto(locale)['como-usar'];
const current = localeFor(locale)!;

const faqLd = page.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: page.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
const howtoLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: page.h1,
  step: page.steps.map((s) => ({ '@type': 'HowToStep', name: s.title, text: s.text })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.nav.home, item: localizedPath(current, '/') },
    { '@type': 'ListItem', position: 2, name: 'How to Download', item: localizedPath(current, route) },
  ],
};
---

<BaseLayout
  locale={locale}
  route={route}
  title={page.title}
  description={page.description}
  jsonLd={[howtoLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])]}
>
  <div class="crumbs"><a href={localizedPath(current, '/')}>{ui.nav.home}</a> / How to Download</div>

  <section class="hero" style="padding-top:8px">
    <h1>{page.h1}</h1>
    <p>{page.intro}</p>
    <ToolForm locale={locale} />
  </section>

  <!-- Stats -->
  <section class="section">
    <div class="grid grid-3 stats">
      {page.stats.map((s) => (
        <div class="card stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- 4 steps -->
  <section class="section">
    <h2>{page.stepsTitle}</h2>
    <p class="lead">{page.stepsLead}</p>
    <div class="grid tool-grid">
      {page.steps.map((s, i) => (
        <div class="card">
          <span class="step-num">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
    <p style="margin-top:20px"><a class="dl-btn" href="#dl">Go to the Downloader</a></p>
  </section>

  <!-- Devices -->
  <section class="section">
    <h2>{page.devicesTitle}</h2>
    <p class="lead">{page.devicesLead}</p>
    <div class="grid" style="gap:20px">
      {page.devices.map((d) => (
        <div class="card device">
          <h3 style="margin-top:0">{d.name}</h3>
          <ol class="device-steps">
            {d.steps.map((st) => <li>{st}</li>)}
          </ol>
          {d.tip && <p class="device-tip"><strong>Tip:</strong> {d.tip}</p>}
        </div>
      ))}
    </div>
  </section>

  <!-- Features -->
  <section class="section">
    <h2>{page.featuresTitle}</h2>
    <div class="grid grid-2">
      {page.features.map((f) => (
        <div class="card">
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Formats -->
  <section class="section">
    <h2>{page.formatsTitle}</h2>
    <div class="grid grid-3">
      {page.formats.map((f) => (
        <div class="card">
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Resolution -->
  <section class="section">
    <h2>{page.resolutionTitle}</h2>
    <p class="muted">{page.resolution}</p>
  </section>

  <!-- Troubleshooting -->
  <section class="section">
    <h2>{page.troubleTitle}</h2>
    <Faq items={page.troubleshooting} />
  </section>

  <!-- Responsible use -->
  <section class="section">
    <div class="card">
      <h2 style="margin-top:0">Responsible Use of Downloaded Content</h2>
      <p class="muted">{ui.responsible.text}</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <h2>{page.faqTitle}</h2>
    {page.faqLead && <p class="lead">{page.faqLead}</p>}
    <Faq items={page.faqs} />
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="card cta">
      <h2 style="margin-top:0">{ui.cta.title}</h2>
      <p class="muted">{ui.cta.text}</p>
      <p><a class="dl-btn" href="#dl">{ui.common.getStarted}</a></p>
    </div>
  </section>
</BaseLayout>