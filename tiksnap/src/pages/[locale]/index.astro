---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolForm from '../../components/ToolForm.astro';
import Faq from '../../components/Faq.astro';
import { getUi, getTools, getPages } from '../../lib/content';
import { TOOLS } from '../../data/tools';
import { localizedPath, localeParams, DEFAULT_LOCALE, localeFor } from '../../lib/i18n';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return localeParams().map((p) => ({ params: p }));
}

const locale = Astro.params.locale ?? DEFAULT_LOCALE;
const route = '/';
const ui = getUi(locale);
const toolCopy = getTools(locale);
const current = localeFor(locale)!;
const faqs = getPages(locale).find((p) => p.slug === 'preguntas-frecuentes')?.faqs ?? [];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: ui.hero.subtitle,
};
const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<BaseLayout
  locale={locale}
  route={route}
  title={ui.hero.title}
  description={ui.hero.subtitle}
  jsonLd={[softwareLd, ...(faqLd ? [faqLd] : [])]}
>
  <section class="hero">
    <h1>{ui.hero.title}</h1>
    <p>{ui.hero.subtitle}</p>
    <ToolForm locale={locale} />
  </section>

  <!-- Feature strip -->
  <section class="section">
    <div class="grid grid-3">
      {ui.features.map((f) => (
        <div class="card">
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 3 steps -->
  <section class="section">
    <h2>{ui.steps.title}</h2>
    <p class="lead">{ui.steps.lead}</p>
    <div class="grid grid-3">
      {ui.steps.items.map((s, i) => (
        <div class="card">
          <span class="step-num">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Responsible use -->
  <section class="section">
    <div class="card">
      <h2 style="margin-top:0">{ui.responsible.title}</h2>
      <p class="muted">{ui.responsible.text}</p>
    </div>
  </section>

  <!-- Why choose -->
  <section class="section">
    <h2>{ui.why.title}</h2>
    <p class="lead">{ui.why.lead}</p>
    <div class="grid grid-3">
      {ui.why.items.map((f) => (
        <div class="card">
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Guide -->
  <section class="section">
    <h2>{ui.guide.title}</h2>
    <p class="lead">{ui.guide.lead}</p>
    <div class="post-body" style="max-width:820px">
      {ui.guide.sections.map((s) => (
        <>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  {faqs.length > 0 && (
    <section class="section">
      <h2>{ui.faqSection.title}</h2>
      <p class="lead">{ui.faqSection.lead}</p>
      <Faq items={faqs} />
    </section>
  )}

  <!-- Other tools -->
  <section class="section">
    <h2>{ui.common.otherTools}</h2>
    <p class="lead">{ui.common.otherToolsLead}</p>
    <div class="grid tool-grid">
      {TOOLS.map((t) => (
        <a class="card tool-card" href={localizedPath(current, `/tools/${t.slug}`)}>
          <h3>{toolCopy[t.slug]?.h1 ?? t.h1}</h3>
          <span class="go">Open →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="card cta">
      <h2 style="margin-top:0">{ui.cta.title}</h2>
      <p class="muted">{ui.cta.text}</p>
      <p><a class="dl-btn" href="#dl">{ui.common.getStarted}</a></p>
    </div>
  </section>
</BaseLayout>