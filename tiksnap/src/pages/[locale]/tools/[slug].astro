---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolForm from '../../../components/ToolForm.astro';
import Faq from '../../../components/Faq.astro';
import { getUi, getTools, getPages } from '../../../lib/content';
import { TOOLS } from '../../../data/tools';
import { localizedPath, localeParams, DEFAULT_LOCALE, localeFor } from '../../../lib/i18n';

export function getStaticPaths() {
  return localeParams().flatMap((lp) =>
    TOOLS.map((t) => ({ params: { ...lp, slug: t.slug } }))
  );
}

const { slug } = Astro.params;
const locale = Astro.params.locale ?? DEFAULT_LOCALE;
const route = `/tools/${slug}`;
const ui = getUi(locale);
const toolCopy = getTools(locale);
const copy = toolCopy[slug];
const current = localeFor(locale)!;
const tool = TOOLS.find((t) => t.slug === slug)!;

const faqPage = getPages(locale).find((p) => p.key === undefined && p.slug === 'preguntas-frecuentes');
const faqs = faqPage?.faqs ?? [];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: copy?.h1 ?? tool.h1,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.nav.home, item: localizedPath(current, '/') },
    { '@type': 'ListItem', position: 2, name: ui.nav.tools, item: localizedPath(current, '/tools') },
    { '@type': 'ListItem', position: 3, name: copy?.h1 ?? tool.h1, item: localizedPath(current, route) },
  ],
};
const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
const jsonLd = [softwareLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];
---

<BaseLayout
  locale={locale}
  route={route}
  title={copy?.title ?? tool.h1}
  description={copy?.description ?? tool.h1}
  jsonLd={jsonLd}
>
  <div class="crumbs">
    <a href={localizedPath(current, '/')}>{ui.nav.home}</a> /{' '}
    <a href={localizedPath(current, '/tools')}>{ui.nav.tools}</a> / {copy?.h1 ?? tool.h1}
  </div>

  <section class="hero" style="padding-top:8px">
    <h1>{copy?.h1 ?? tool.h1}</h1>
    <p>{copy?.intro ?? copy?.description}</p>
    <ToolForm locale={locale} />
  </section>

  {faqs.length > 0 && (
    <section class="section">
      <h2>{ui.nav.faq}</h2>
      <Faq items={faqs} />
    </section>
  )}

  <section class="section">
    <h2>{ui.common.otherTools}</h2>
    <div class="grid tool-grid">
      {TOOLS.filter((t) => t.slug !== slug).map((t) => (
        <a class="card tool-card" href={localizedPath(current, `/tools/${t.slug}`)}>
          <h3>{toolCopy[t.slug]?.h1 ?? t.h1}</h3>
          <span class="go">Open →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>