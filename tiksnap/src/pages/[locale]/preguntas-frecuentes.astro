---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUi, getFaq } from '../../lib/content';
import { localizedPath, localeParams, DEFAULT_LOCALE, localeFor } from '../../lib/i18n';

export function getStaticPaths() {
  return localeParams().map((p) => ({ params: p }));
}

const locale = Astro.params.locale ?? DEFAULT_LOCALE;
const route = '/preguntas-frecuentes';
const ui = getUi(locale);
const faq = getFaq(locale);
const current = localeFor(locale)!;

const allFaqs = faq?.categories.flatMap((c) => c.faqs) ?? [];
const faqLd = allFaqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: allFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.nav.home, item: localizedPath(current, '/') },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: localizedPath(current, route) },
  ],
};

if (!faq) return Astro.redirect('/');
---

<BaseLayout
  locale={locale}
  route={route}
  title={faq.title}
  description={faq.description}
  jsonLd={[breadcrumbLd, ...(faqLd ? [faqLd] : [])]}
>
  <div class="crumbs"><a href={localizedPath(current, '/')}>{ui.nav.home}</a> / FAQ</div>

  <section class="hero" style="padding-top:8px">
    <h1>{faq.h1}</h1>
    <p>{faq.intro}</p>
  </section>

  {faq.categories.map((cat) => (
    <section class="section">
      <h2>{cat.name}</h2>
      <p class="lead">{cat.blurb}</p>
      <div class="faq">
        {cat.faqs.map((it) => (
          <details class="faq-item">
            <summary class="faq-q">{it.q}</summary>
            <div class="faq-a">{it.a}</div>
          </details>
        ))}
      </div>
    </section>
  ))}

  <section class="section">
    <div class="card cta">
      <h2 style="margin-top:0">{ui.cta.title}</h2>
      <p class="muted">{ui.cta.text}</p>
      <p><a class="dl-btn" href={localizedPath(current, '/')}>{ui.common.getStarted}</a></p>
    </div>
  </section>
</BaseLayout>